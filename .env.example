# Vorlage für die Zugangsdaten zur Datenbank.
# Kopieren nach .env und bei Bedarf anpassen: cp .env.example .env
# Die Datei .env wird nicht ins Repository übernommen (.gitignore).
# Ohne .env gelten die Werte aus docs/setup.sql (Benutzer kicker auf localhost).

DB_HOST=localhost
DB_PORT=3306
DB_USER=kicker
DB_PASSWORD=kicker
DB_NAME=kickerrank
